# ------------------------------------------------------------
# AutoPart Pro — variables de entorno
# Copia este archivo como .env (local) y configúralas en Vercel.
# ------------------------------------------------------------

# Conexión MySQL (local o en la nube: TiDB Cloud Starter, Railway…)
DATABASE_URL=mysql://usuario:clave@localhost:3306/autopart
# true para conexiones en la nube (TiDB Cloud exige TLS)
DB_SSL=false
# Solo si el proveedor usa un CA propio: contenido del ca.pem en una línea con \n
DB_SSL_CA=

# Secreto para firmar los tokens JWT del panel admin (cadena larga y aleatoria)
JWT_SECRET=

# URL pública del sitio (para el redirect de Wompi). Ej: https://autopart-pro.vercel.app
PUBLIC_SITE_URL=

# Wompi — llaves del entorno Sandbox (panel comercios.wompi.co > Desarrolladores)
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxx
